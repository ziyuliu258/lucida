# Python bytecode, test and build output
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
build/
dist/

# Local virtual environments and dependency snapshots
/env/
/env-*/
/.venv/
/venv/
/environment/

# Local caches, credentials and editor/OS files
.cache/
.env
.env.*
!.env.example
.DS_Store
*.swp
*.swo

# Downloaded datasets, generated manifests/observations and vendored source
/data/*
!/data/README.md
/third_party/

# Pretrained weights and generated training/evaluation artifacts
/models/*
!/models/README.md
/outputs/

# Working documents, generated reports and the source paper stay local.
# The root README.md remains the repository's published overview.
/docs/

# Logs and common model/checkpoint archives
*.log
*.ckpt
*.safetensors
